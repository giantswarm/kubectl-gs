apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  # It applies itself, so renaming it would make it prune itself, and its
  # finalizer would delete everything it applied. The annotation leaves it, as
  # it does each organisation's namespace Kustomization.
  annotations:
    kustomize.toolkit.fluxcd.io/prune: disabled
  name: demomc-gitops
  namespace: default
spec:
  decryption:
    provider: sops
    secretRef:
      name: sops-gpg-master
  interval: 1m
  path: ./management-clusters/demomc
  # Flux deletes what you delete from Git. The objects whose deletion would
  # delete a cluster, or stop Flux from decrypting, have the
  # `kustomize.toolkit.fluxcd.io/prune: disabled` annotation, so Flux leaves
  # them, and the `giantswarm.io/prevent-deletion` label, so nobody can delete
  # them until it's removed.
  prune: true
  serviceAccountName: automation
  sourceRef:
    kind: GitRepository
    name: gitops-demo
  timeout: 2m
