{{- if and .AppBase .AppUserValuesConfigMap -}}
- op: add
  path: /spec/valuesFrom/-
  value:
    kind: ConfigMap
    name: {{ .WorkloadCluster}}-{{ .AppName }}-user-values
    valuesKey: values
{{ end -}}
{{- if and .AppBase .AppUserValuesSecret -}}
- op: add
  path: /spec/valuesFrom/-
  value:
    kind: Secret
    name: {{ .WorkloadCluster}}-{{ .AppName }}-user-values
    valuesKey: values
{{ end -}}
