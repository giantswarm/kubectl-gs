{{- if .AppBase -}}
apiVersion: kustomize.config.k8s.io/v1beta1
buildMetadata: [originAnnotations]
{{- if or .AppUserValuesConfigMap .AppUserValuesSecret }}
patches:
  - path: patch_app_userconfig.yaml
    target:
      group: helm.toolkit.fluxcd.io
      kind: HelmRelease
      # A regular expression matching the name the base gives the HelmRelease
      # before Flux substitutes the variables.
      name: \$\{cluster_name\}-{{ .AppName }}
{{- end }}
kind: Kustomization
resources:
{{- if .SkipMAPI }}
  - ../../../../../../../../{{ .AppBase }}
{{- else }}
  - ../../../../../../../../../{{ .AppBase }}
{{- end }}
{{- if .AppUserValuesConfigMap }}
  - configmap.yaml
{{- end }}
{{- if .AppUserValuesSecret }}
  - secret.enc.yaml
{{- end }}
{{- end }}
