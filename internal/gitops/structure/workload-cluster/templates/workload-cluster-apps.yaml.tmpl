{{- if .AppsKustomization -}}
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ .ManagementCluster }}-clusters-{{ .WorkloadCluster }}-apps
spec:
  # the secondary apps, in apps/, install once the cluster is up, see {{ .WorkloadCluster }}.yaml
  dependsOn:
    - name: {{ .ManagementCluster }}-clusters-{{ .WorkloadCluster }}
  interval: 10m
  path: "./management-clusters/{{ .ManagementCluster }}/organizations/{{ .Organization }}/workload-clusters/{{ .WorkloadCluster }}"
  postBuild:
    substitute:
      cluster_name: {{ .WorkloadCluster }}
      cluster_description: "{{ .WorkloadCluster }} managed by GitOps"
      {{- if .Release }}
      release: {{ .Release }}
      {{- end }}
      organization: "${organization}"
  prune: true
  retryInterval: 1m
  serviceAccountName: automation
  sourceRef:
    kind: GitRepository
    name: {{ .RepositoryName }}
    namespace: default
  timeout: 2m
{{- end }}
