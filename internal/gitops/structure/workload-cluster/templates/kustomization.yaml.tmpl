{{- if .ClusterBase -}}
apiVersion: kustomize.config.k8s.io/v1beta1
commonLabels:
  giantswarm.io/managed-by: flux
kind: Kustomization
patches:
  - path: patch_cluster_userconfig.yaml
resources:
{{- if .SkipMAPI }}
  - ../../../../../../../{{ .ClusterBase }}
{{- else }}
  - ../../../../../../../../{{ .ClusterBase }}
{{- end }}
  - cluster_userconfig.yaml
{{- end }}
