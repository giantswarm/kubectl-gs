apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: {{ .ManagementCluster }}-clusters-{{ .WorkloadCluster }}
spec:
  # Flux applies a commit here only once the organisation's namespace
  # Kustomization, which applies this one, is Ready at it, so this one's spec
  # is up to date.
  dependsOn:
    - name: {{ .ManagementCluster }}-organization-{{ .Organization }}
      namespace: default
  {{- if .AppsKustomization }}
  # Applies the cluster and its base apps, in cluster/. Ready once Cluster API
  # reports the cluster's control plane available and reachable, which is all
  # the apps need. The Kustomization in {{ .WorkloadCluster }}-apps.yaml depends on this one, so
  # the secondary apps install once the cluster is up. It doesn't wait for
  # `Available`, which counts every node pool: one node pool short of its
  # minimum would hold back every change to the apps.
  healthCheckExprs:
    - apiVersion: cluster.x-k8s.io/v1beta2
      kind: Cluster
      current: >-
        status.conditions.exists(c, c.type == 'ControlPlaneAvailable' && c.status == 'True')
        && status.conditions.exists(c, c.type == 'RemoteConnectionProbe' && c.status == 'True')
  healthChecks:
    - apiVersion: cluster.x-k8s.io/v1beta2
      kind: Cluster
      name: {{ .WorkloadCluster }}
      # the organisation's namespace, from its namespace Kustomization
      namespace: org-${organization}
  {{- end }}
  interval: 10m
  path: "./management-clusters/{{ .ManagementCluster }}/organizations/{{ .Organization }}/workload-clusters/{{ .WorkloadCluster }}{{ if .AppsKustomization }}/cluster{{ end }}"
  postBuild:
    substitute:
      cluster_name: {{ .WorkloadCluster }}
      {{- if .ClusterBase }}
      cluster_description: "{{ .WorkloadCluster }} managed by GitOps"
      {{- end }}
      {{- if .Release }}
      release: {{ .Release }}
      {{- end }}
      organization: "${organization}"
  prune: true
  retryInterval: 1m
  serviceAccountName: automation
  sourceRef:
    kind: GitRepository
    name: {{ .RepositoryName }}
    namespace: default
  {{- if .AppsKustomization }}
  # long enough for a new cluster to come up
  timeout: 30m
  {{- else }}
  timeout: 2m
  {{- end }}
