---
apiVersion: v1
data:
  values: |
    global:
      connectivity:
        availabilityZoneUsageLimit: 3
        network:
          vpcCidr: 10.123.0.0/16
        subnets:
        - cidrBlocks:
          - availabilityZone: a
            cidr: 10.123.64.0/18
          - availabilityZone: b
            cidr: 10.123.128.0/18
          - availabilityZone: c
            cidr: 10.123.192.0/18
          isPublic: false
        - cidrBlocks:
          - availabilityZone: a
            cidr: 10.123.0.0/20
          - availabilityZone: b
            cidr: 10.123.16.0/20
          - availabilityZone: c
            cidr: 10.123.32.0/20
          isPublic: true
        topology: {}
      controlPlane:
        instanceType: control-plane-instance-type
      metadata:
        description: cluster using release version directly
        name: test10
        organization: test
        preventDeletion: false
      nodePools:
        worker1:
          availabilityZones:
          - eu-west-1a
          - eu-west-1b
          customNodeLabels:
          - label=value
          instanceType: big-one
          maxSize: 5
          minSize: 2
          rootVolumeSizeGB: 200
      providerSpecific:
        awsClusterRoleIdentityName: default
        region: the-region
kind: ConfigMap
metadata:
  labels:
    giantswarm.io/cluster: test10
  name: test10-userconfig
  namespace: org-test
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  labels:
    giantswarm.io/cluster: test10
  name: test10
  namespace: org-test
spec:
  interval: 10m0s
  provider: generic
  ref:
    tag: 35.0.0
  timeout: 1m0s
  url: oci://gsoci.azurecr.io/charts/giantswarm/release-aws
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    giantswarm.io/cluster: test10
  name: test10
  namespace: org-test
spec:
  chartRef:
    kind: OCIRepository
    name: test10
    namespace: org-test
  install:
    remediation:
      remediateLastFailure: false
      retries: 10
  interval: 5m0s
  releaseName: test10
  serviceAccountName: automation
  storageNamespace: org-test
  targetNamespace: org-test
  timeout: 10m0s
  upgrade:
    remediation:
      remediateLastFailure: true
      retries: 10
      strategy: rollback
  valuesFrom:
  - kind: ConfigMap
    name: test10-userconfig
    valuesKey: values
