---
apiVersion: v1
data:
  values: |
    global:
      metadata:
        description: cluster using a release without a published release-eks chart
        name: test-eks-fallback
        organization: test
      release:
        version: 35.0.0
kind: ConfigMap
metadata:
  labels:
    giantswarm.io/cluster: test-eks-fallback
  name: test-eks-fallback-userconfig
  namespace: org-test
---
apiVersion: application.giantswarm.io/v1alpha1
kind: App
metadata:
  labels:
    app-operator.giantswarm.io/version: 0.0.0
  name: test-eks-fallback
  namespace: org-test
spec:
  catalog: cluster
  config:
    configMap:
      name: ""
      namespace: ""
    secret:
      name: ""
      namespace: ""
  kubeConfig:
    context:
      name: ""
    inCluster: true
    secret:
      name: ""
      namespace: ""
  name: cluster-eks
  namespace: org-test
  userConfig:
    configMap:
      name: test-eks-fallback-userconfig
      namespace: org-test
  version: 1.0.0
