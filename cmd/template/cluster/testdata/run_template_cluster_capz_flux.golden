---
apiVersion: v1
data:
  values: |
    global:
      connectivity:
        bastion:
          enabled: true
      controlPlane:
        instanceType: B2s
        replicas: 3
      metadata:
        description: cluster using release version directly
        name: test-capz-flux
        organization: test
      providerSpecific:
        location: northeurope
        subscriptionId: 12345678-ebb8-4b1f-8f96-d950d9e7aaaa
kind: ConfigMap
metadata:
  labels:
    giantswarm.io/cluster: test-capz-flux
  name: test-capz-flux-userconfig
  namespace: org-test
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  labels:
    giantswarm.io/cluster: test-capz-flux
  name: test-capz-flux
  namespace: org-test
spec:
  interval: 10m0s
  provider: generic
  ref:
    tag: 35.0.0
  timeout: 1m0s
  url: oci://gsoci.azurecr.io/charts/giantswarm/release-azure
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    giantswarm.io/cluster: test-capz-flux
  name: test-capz-flux
  namespace: org-test
spec:
  chartRef:
    kind: OCIRepository
    name: test-capz-flux
    namespace: org-test
  install:
    remediation:
      remediateLastFailure: false
      retries: 10
  interval: 5m0s
  releaseName: test-capz-flux
  serviceAccountName: automation
  storageNamespace: org-test
  targetNamespace: org-test
  timeout: 10m0s
  upgrade:
    remediation:
      remediateLastFailure: true
      retries: 10
      strategy: rollback
  valuesFrom:
  - kind: ConfigMap
    name: test-capz-flux-userconfig
    valuesKey: values
