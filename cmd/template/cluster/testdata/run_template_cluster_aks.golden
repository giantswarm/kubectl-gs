---
apiVersion: v1
data:
  values: |
    global:
      controlPlane:
        sku:
          tier: Standard
      managementCluster: my-mc
      metadata:
        description: an AKS test cluster
        name: test-aks
        organization: test
      providerSpecific:
        azureClusterIdentity:
          name: my-aks-identity
          namespace: org-test
        location: westeurope
        subscriptionId: 6b1f6e4a-6d0e-4aa4-9a5a-fbaca65a23b3
kind: ConfigMap
metadata:
  labels:
    giantswarm.io/cluster: test-aks
  name: test-aks-userconfig
  namespace: org-test
---
apiVersion: source.toolkit.fluxcd.io/v1
kind: OCIRepository
metadata:
  labels:
    giantswarm.io/cluster: test-aks
  name: test-aks
  namespace: org-test
spec:
  interval: 10m0s
  provider: generic
  ref:
    tag: 35.0.0
  timeout: 1m0s
  url: oci://gsoci.azurecr.io/charts/giantswarm/release-aks
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  labels:
    giantswarm.io/cluster: test-aks
  name: test-aks
  namespace: org-test
spec:
  chartRef:
    kind: OCIRepository
    name: test-aks
    namespace: org-test
  install:
    remediation:
      remediateLastFailure: false
      retries: 10
  interval: 5m0s
  releaseName: test-aks
  serviceAccountName: automation
  storageNamespace: org-test
  targetNamespace: org-test
  timeout: 10m0s
  upgrade:
    remediation:
      remediateLastFailure: true
      retries: 10
      strategy: rollback
  valuesFrom:
  - kind: ConfigMap
    name: test-aks-userconfig
    valuesKey: values
