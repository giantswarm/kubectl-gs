---
apiVersion: v1
data:
  values: |
    global:
      connectivity:
        availabilityZoneUsageLimit: 3
        network: {}
        topology: {}
      controlPlane:
        instanceType: control-plane-instance-type
        oidc:
          clientId: my-client
          groupsClaim: groups
          issuerUrl: https://idp.example.com
          usernameClaim: email
      metadata:
        description: OIDC test cluster
        name: test-oidc
        organization: test
        preventDeletion: false
      nodePools:
        worker1:
          availabilityZones:
          - eu-west-1a
          instanceType: big-one
          maxSize: 5
          minSize: 2
      providerSpecific:
        awsClusterRoleIdentityName: default
        region: the-region
      release:
        version: 25.0.0
kind: ConfigMap
metadata:
  labels:
    giantswarm.io/cluster: test-oidc
  name: test-oidc-userconfig
  namespace: org-test
---
apiVersion: application.giantswarm.io/v1alpha1
kind: App
metadata:
  labels:
    app-operator.giantswarm.io/version: 0.0.0
  name: test-oidc
  namespace: org-test
spec:
  catalog: cluster
  config:
    configMap:
      name: ""
      namespace: ""
    secret:
      name: ""
      namespace: ""
  kubeConfig:
    context:
      name: ""
    inCluster: true
    secret:
      name: ""
      namespace: ""
  name: cluster-aws
  namespace: org-test
  userConfig:
    configMap:
      name: test-oidc-userconfig
      namespace: org-test
  version: ""
